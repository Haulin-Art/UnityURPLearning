#pragma kernel CSClear
#pragma kernel CSDrawCircle

// 目标贴图，用于读写
RWTexture2D<float4> ResultTexture;

// 绘制参数
int _Width;
int _Height;
float2 _CenterUV;
float _Radius;
float4 _CircleColor;

/// <summary>
/// 清空贴图（可选功能）
/// </summary>
[numthreads(8, 8, 1)]
void CSClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height)
        return;

    // 将所有像素设置为透明
    ResultTexture[int2(id.x, id.y)] = float4(0, 0, 0, 0);
}

/// <summary>
/// 在指定UV位置绘制实心圆
/// 使用混合模式，保留已有绘制内容
/// </summary>
[numthreads(8, 8, 1)]
void CSDrawCircle(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height)
        return;

    int2 pixelPos = int2(id.x, id.y);

    // 将像素坐标转换为UV坐标（0-1范围）
    float2 pixelUV = float2(pixelPos.x / (float)_Width, pixelPos.y / (float)_Height);

    // 计算当前像素到圆心的距离
    float dist = distance(pixelUV, _CenterUV);

    // 将UV距离转换为像素距离进行判断
    // UV空间中的半径 = 像素半径 / 贴图尺寸
    float radiusInUV = _Radius / max(_Width, _Height);

    // 如果在圆内，则绘制颜色
    if (dist <= radiusInUV)
    {
        // 读取当前像素值
        float4 currentColor = ResultTexture[pixelPos];

        // 使用混合模式：新颜色覆盖旧颜色（支持多次绘制）
        // 如果需要透明混合，可以使用 lerp
        ResultTexture[pixelPos] = _CircleColor;
    }
}
