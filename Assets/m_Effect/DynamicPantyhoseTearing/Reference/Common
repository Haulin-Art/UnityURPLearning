const float SIDE_LEN = 4.; // 布料在世界空间中的边长

// -------------------------------------------------------------------
// 7. 布料网格参数与邻居查找
// -------------------------------------------------------------------

// 全局变量，由 computeClothSide() 初始化
int CLOTH_SIDE = 0;    // 布料每条边有多少个粒子（网格为 CLOTH_SIDE × CLOTH_SIDE）
int MAX_PARTICLES = 0; // 总粒子数 = CLOTH_SIDE²

// 根据当前屏幕分辨率计算布料网格的大小
// 粒子利用率随分辨率升高而降低（高分辨率时不需要那么密的粒子）
// particleUse 范围：~0.58(高分) ~ 0.7(低分)
void computeClothSide(vec3 res)
{
    float particleUse = 0.7 * (1. - 0.6 * smoothstep(1000., 1200., res.y));
    CLOTH_SIDE = int(sqrt(res.x * res.y / float(NUM_PARTICLE_DATA_TYPES)) * particleUse);
    MAX_PARTICLES = CLOTH_SIDE * CLOTH_SIDE;
}

// -------------------------------------------------------------------
// 8. 邻居查找函数 — 布料网格的四向拓扑关系
// -------------------------------------------------------------------
// 关键设计：如果输入已经是 -1（表示之前的邻居已失效），继续返回 -1
// 这样约束循环不需要在每层都检查终止条件，大幅简化迭代逻辑

// 上方邻居（行号 -1），边界外返回 -1
int above(int i)
{
    return i >= 0 && i >= CLOTH_SIDE ? i - CLOTH_SIDE : -1;
}

// 下方邻居（行号 +1），边界外返回 -1
int below(int i)
{
    return i >= 0 && i < (CLOTH_SIDE * (CLOTH_SIDE - 1)) ? i + CLOTH_SIDE : -1;
}

// 左方邻居（列号 -1），边界外返回 -1
int left(int i)
{
    return i >= 0 && (i % CLOTH_SIDE) != 0 ? i - 1 : -1;
}

// 右方邻居（列号 +1），边界外返回 -1
int right(int i)
{
    return i >= 0 && (i % CLOTH_SIDE) != CLOTH_SIDE - 1 ? i + 1 : -1;
}
