// ============================================================================
// Image — 显示
// iChannel0 = Buffer A (RG=速度, BA=平流后UV位置)
// iChannel1 = Buffer B (R=染料)
// ============================================================================

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    vec2 uv = fragCoord / iResolution.xy;
    vec4 bufA = texture(iChannel0, uv);
    vec2 vel  = bufA.rg;
    vec2 tag  = bufA.ba;
    float dye = texture(iChannel1, uv).r;

    vec3 color;

#if DISPLAY_MODE == 0
    // 速度场 — 色相=方向, 亮度=大小
    float mag = length(vel);
    float angle = atan(vel.y, vel.x);
    float hue = angle / 6.28318 + 0.5;
    color = 0.5 + 0.5 * cos(6.28318 * (hue + vec3(0.0, 0.33, 0.67)));
    color = mix(vec3(0.15), color, clamp(mag / MAX_SPEED, 0.0, 1.0));

#elif DISPLAY_MODE == 1
    // 染料场 — 热力图
    dye = clamp(dye, 0.0, 1.0);
    if (dye < 0.33)
        color = mix(vec3(0,0,0), vec3(0.8,0,0), dye / 0.33);
    else if (dye < 0.66)
        color = mix(vec3(0.8,0,0), vec3(1,0.5,0), (dye - 0.33) / 0.33);
    else
        color = mix(vec3(1,0.5,0), vec3(1,1,1), (dye - 0.66) / 0.34);

#else
    // UV位移场 — 色相=位移方向, 亮度=位移量
    vec2 disp = tag - uv;
    float mag = length(disp);
    float angle = atan(disp.y, disp.x);
    float hue = angle / 6.28318 + 0.5;
    color = 0.5 + 0.5 * cos(6.28318 * (hue + vec3(0.0, 0.33, 0.67)));
    color = mix(vec3(0.15), color, clamp(mag * 50.0, 0.0, 1.0));
#endif

    fragColor = vec4(color, 1.0);
}
