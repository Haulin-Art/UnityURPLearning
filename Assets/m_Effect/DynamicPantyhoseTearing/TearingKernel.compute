#pragma kernel InitKernel
#pragma kernel TearingKernel
#pragma kernel InitParticleKernel
#pragma kernel UpdateParticleKernel

// ── 模拟参数 ──
float _TexSize;             // 网格分辨率
float _DT;                  // 时间步长
float4 _PenPos;             // xy=当前画笔UV, zw=上一帧画笔UV
float _Radius;              // 画笔半径
float _KeyDown;             // 是否按下 (0/1)
float _RetractionStrength;  // 回缩强度 (0~1)
float _Damping;             // 弹性记忆: 位移向零点回归速率
float _StretchStiffness;    // 拉伸刚度: 越大越难拉伸

// ── 只读纹理（用于 SampleLevel 线性采样）──
Texture2D<float2>  _HoleTex;    // 空洞字段 0=完好 1=空洞
Texture2D<float4> _DispTex;    // 位移字段

// ── 可写缓冲（ping-pong 写目标）──
RWTexture2D<float2>  _HoleWrite;
RWTexture2D<float4> _DispWrite;


// 粒子数据信息
Texture2D<float4> _ParticlePosRead;
RWTexture2D<float4> _ParticlePosWrite;
float _ParticleGridSize;
Texture2D<float> _ParticleStateRead;
RWTexture2D<float> _ParticleStateWrite;



// ── 线性采样器 ──
SamplerState samplerLinearClamp
{
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Clamp;
    AddressV = Clamp;
};



// 通过1D索引反算Uint2区域索引（行主序）
// index : 1D索引
// width : 每一行有多少个区域（列数）
uint2 PointID2Uint2(uint index, uint width)
{
    uint y = index / width;
    uint x = index - y * width;
    return uint2(x, y);
}
// ===================================================================
// InitKernel: 初始化缓存纹理为粒子 cell 坐标（仅运行一次）
// _DispTex.xy = 该像素上一帧最近的粒子 cell 坐标（整数）
// ===================================================================
[numthreads(8, 8, 1)]
void InitKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 pos = id.xy;
    float2 uv = ((float2)pos + 0.5) / _TexSize;
    _DispWrite[pos] = float4(floor(uv * _ParticleGridSize), 0, 0);
    _HoleWrite[pos] = float2(0, 0);
}

// ===================================================================
// TearingKernel: P2G — 将粒子位置转换为可视化 mask
// ===================================================================
[numthreads(8, 8, 1)]
void TearingKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 pos = id.xy;
    float2 uv = ((float2)pos + 0.5) / _TexSize;
    float h = 1.0 / _TexSize;

    float mask = 0.0;

    /////* 方法讲解：
    /*
    通过不断记录最接近当前像素的粒子 cell 坐标
    在每次的最开始，使用上一帧的最优粒子 cell，采样它的位置
    然后通过位移逆向得到另一个搜索区域，围绕该区域采样，比较出本帧的最优粒子
    最终写入本帧最优粒子的 cell 坐标（不是 UV 位置），供下一帧使用
    */
    //////
    uint2 last_OptPos = uint2(_DispTex[pos].xy);          // 上一帧最优粒子的 cell 坐标
    if (last_OptPos.x >= (uint)_ParticleGridSize) last_OptPos.x = 0;
    if (last_OptPos.y >= (uint)_ParticleGridSize) last_OptPos.y = 0;

    // 读缓存粒子的数据，用于位移引导
    float4 cachedParticle = _ParticlePosRead[last_OptPos];
    float2 cachedCurPos  = cachedParticle.xy;
    float  cachedState   = _ParticleStateRead[last_OptPos];

    // 如果缓存粒子已撕裂，回退到像素所在网格 cell
    if (cachedState > 0.5)
        last_OptPos = uint2(floor(uv * _ParticleGridSize));

    // 位移逆向引导：粒子从 home 偏移了多少，就逆向偏移搜索中心
    float2 homeUV  = (float2(last_OptPos) + 0.5) / _ParticleGridSize;
    float2 curRef  = _ParticlePosRead[last_OptPos].xy;
    float2 posDelta = homeUV - curRef;
    uint2 dirUV = uint2(floor((uv + posDelta) * _ParticleGridSize));
    dirUV = clamp(dirUV, 0, (uint)(_ParticleGridSize - 1));

    // 搜索最接近 uv 的粒子（3×3 区域，过滤 disabled）
    float bestDist = 1e6;
    float2 bestPos  = float2(0, 0);
    int2   bestCell = int2(0, 0);

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 nID = int2(dirUV) + int2(dx, dy);
            if (any(nID < 0) || nID.x >= (int)_ParticleGridSize || nID.y >= (int)_ParticleGridSize)
                continue;

            float st = _ParticleStateRead[nID];
            if (st > 0.5) continue;  // 跳过已撕裂的粒子

            float2 np = _ParticlePosRead[nID].xy;
            float d = length(uv - np);
            if (d < bestDist)
            {
                bestDist = d;
                bestPos  = np;
                bestCell = nID;
            }
        }
    }

    mask = step(bestDist, h * 3.0);
    _DispWrite[pos] = float4(bestCell, 0, 0);  // 存 cell 坐标，不是 UV 位置
    _HoleWrite[pos] = float2(mask, 0);
}


/// 参数分别为 期望距离、当前粒子位置、邻居粒子ID
float2 particleConstraint(float eLen, float2 cPos, int2 nID)
{
    if (nID.x < 0 || nID.y < 0 || nID.x >= _ParticleGridSize || nID.y >= _ParticleGridSize) return float2(0, 0);

    float particleState = _ParticleStateRead[nID];
    if (particleState > 0.5) return float2(0, 0);

    float4 neiborParticle = _ParticlePosRead[nID];
    float2 nPos = neiborParticle.xy;

    float2 deltaPos = nPos - cPos.xy;   // 当前粒子指向邻居的向量
    float len = length(deltaPos);    // 当前实际距离
    float2 dir = deltaPos / len;       // 单位方向向量

    float error = len - eLen;     // 距离误差（正=拉伸, 负=压缩）

    // 关键设计：压缩误差仅取 0.5%，布料可自然折叠而不会弹跳
    if (error < 0.) error *= 0.005;

    // 位置修正：固定粒子的权重为 1.0（对方全量移动），普通粒子权重 0.5
    // 这样 pinned 粒子完全不动，普通粒子各承担大约一半的修正量
    bool pinned = nID.x == 0 || nID.y == 0 || nID.x == _ParticleGridSize-1 || nID.y == _ParticleGridSize-1 ? true : false;
    float f = pinned ? 1.0 : .5;

    return dir * error * f;
}

[numthreads(8, 8, 1)]
void InitParticleKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 pos = id.xy;
    float2 uv = ((float2)pos + 0.5) / _ParticleGridSize;
    _ParticlePosWrite[pos] = float4(uv, uv);
    _ParticleStateWrite[pos] = 0.0;
}
[numthreads(8, 8, 1)]
void UpdateParticleKernel(uint3 id : SV_DispatchThreadID)
{
    // 如果当前点是边缘固定点，不更新
    if (id.x == 0 || id.y == 0 || id.x == _ParticleGridSize-1 || id.y == _ParticleGridSize-1)
    {
        _ParticlePosWrite[id.xy] = _ParticlePosRead[id.xy];
        return;
    }
    uint2 pos = id.xy;
    float2 uv = ((float2)pos + 0.5) / _ParticleGridSize;

    float4 particlePos      = _ParticlePosRead[id.xy];
    float2 lastPos          = particlePos.zw;           // 上一帧位置
    float2 curPos           = particlePos.xy;           // 当前帧位置

    // 更新失活数据：用粒子当前位置比较，不是 home UV
    float particleState = _ParticleStateRead[id.xy];
    float distToPen = length(curPos - _PenPos.xy);
    float erzhiinHole = (1.0 - step(_Radius, distToPen)) * _KeyDown;
    float newState = saturate(particleState + erzhiinHole);
    _ParticleStateWrite[pos] = newState;

    // 判断当前粒子是否失活
    if (newState > 0.5)
    {
        _ParticlePosWrite[id.xy] = float4(uv, uv);
        return;
    }

    float2 velocity         = (curPos - lastPos);       // 当前帧速度
    float2 gravity          = float2(0, -0.0005);        // 重力
    float  expectedDistance = 1.0 / _ParticleGridSize;  // 期望距离

    // Verlet 更新
    float2 new_pos = curPos + velocity + gravity * _DT * _DT; // 更新当前帧位置

    // 更新约束
    float2 upConstraint    = particleConstraint(expectedDistance, new_pos, id.xy + int2(0, 1));
    float2 downConstraint  = particleConstraint(expectedDistance, new_pos, id.xy - int2(0, 1));
    float2 leftConstraint  = particleConstraint(expectedDistance, new_pos, id.xy - int2(1, 0));
    float2 rightConstraint = particleConstraint(expectedDistance, new_pos, id.xy + int2(1, 0));

    new_pos += (upConstraint + downConstraint + leftConstraint + rightConstraint) * _DT;

    _ParticlePosWrite[pos] = float4(new_pos, curPos);
}
