    float2(-1,  0), float2( 1,  0), float2( 0, -1), float2( 0, 1),
    float2(-0.70710678, -0.70710678), float2( 0.70710678,  0.70710678),
    float2(-0.70710678,  0.70710678), float2( 0.70710678, -0.70710678)
};
// 静止距离: 正交=1, 对角=√2
static const float _RestDist[8] = {
    1.0, 1.0, 1.0, 1.0,
    1.41421356, 1.41421356, 1.41421356, 1.41421356
};

// 点到线段的距离（连接上一帧位置，防快速移动时轨迹断裂）
float distToLine(float2 uv, float2 a, float2 b)
{
    float2 ab = b - a;
    float len2 = dot(ab, ab);
    if (len2 < 1e-10) return length(uv - a);
    float t = saturate(dot(uv - a, ab) / len2);
    return length(uv - a - ab * t);
}
