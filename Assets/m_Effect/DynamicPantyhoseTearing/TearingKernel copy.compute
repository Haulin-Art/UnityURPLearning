// ===================================================================
// InitKernel: 初始化位移场为像素UV位置（仅运行一次）
// ===================================================================
[numthreads(8, 8, 1)]
void InitKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 pos = id.xy;
    _DispWrite[pos] = float4(((float2)pos + 0.5) / _TexSize,((float2)pos + 0.5) / _TexSize);
    _HoleWrite[pos] = float2(0,0);
}

// ===================================================================
// TearingKernel: 单 kernel 完成弹性回缩 + 拉伸极限 + 空洞输入
// ===================================================================
[numthreads(8, 8, 1)]
void TearingKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 pos = id.xy;
    float2 uv = ((float2)pos + 0.5) / _TexSize;
    float h = 1.0 / _TexSize;

    // ── 1. SampleLevel 读取当前状态 ──
    float2  hole_self = _HoleTex.SampleLevel(samplerLinearClamp, uv, 0);
    float2 disp_self = _DispTex.SampleLevel(samplerLinearClamp, uv, 0).xy;

    /*
    // 完全空洞 → 位移归零，直接返回
    if (hole_self.x >= 0.999)
    {
        _DispWrite[pos] = float4(((float2)pos + 0.5) / _TexSize,((float2)pos + 0.5) / _TexSize);
        _HoleWrite[pos] = hole_self;
        return;
    }


    // ── 3. 遍历 8 邻域: 计算回缩力 + 拉伸量 ──
    float2 retractionDir   = float2(0, 0);   // 回缩方向（向量）
    float  excessStretch   = 0.0;            // 累计超限拉伸
    float  validCount      = 0.0;            // 非空洞邻居计数

    float2 lache = float2(0,0);              // 拉伸方向（向量）
    */
    /*
    for (int k = 0; k < 8; k++)
    {
        // 采样邻居数据
        float2 nUV  = uv + float2(_Offsets[k].x, _Offsets[k].y) * h;
        float2  hole_n = _HoleTex.SampleLevel(samplerLinearClamp, nUV, 0);
        float2 disp_n = _DispTex.SampleLevel(samplerLinearClamp, nUV, 0).xy;

        //float diff = hole_n - hole_self;
        // 回缩力的大小取决于方向与空洞系数，越是空洞影响越小
        retractionDir += _Dirs[k] * _RetractionStrength * (1.0-hole_n.x) * h;

        float2 cc = 0.9*h - length(disp_n - disp_self);

        //float2 nCurPos = nUV + disp_n;
        float actualDist = length(disp_n - disp_self);
        float restDist   = _RestDist[k] * h;
        excessStretch += max(0.0, abs(actualDist - restDist));
        validCount += (1.0 - hole_n.x);

        lache += _Dirs[k] * cc * step(0.0001,length(disp_n));
    }
    */
    /*
    // ── 4. 拉伸限制因子 ──
    float avgExcess = excessStretch / max(validCount, 1);
    //lache /= max(validCount, 1);
    //avgExcess = exp(avgExcess*_TexSize)-1.0;
    float stretchFactor = 1.0 / (1.0 +_StretchStiffness * avgExcess);
    stretchFactor = 1.0 / (exp(max(0,0*10.0*(excessStretch + hole_self.y))));
    stretchFactor = 1.0;
    
    // ── 5. 位移更新 ──
    float2 u_new =  retractionDir * _DT;
    //u_new /= (1.0-validCount)/8.0 + 1.0;            // 按理说，空洞邻居越多，越不会扩展
    u_new = lerp(u_new, float2(0, 0), _Damping);   
    u_new = clamp(u_new, -0.5, 0.5);               // 位移限幅防数值爆炸
    u_new *= float2(2.0,1.0);                      // 布料的各向异性变形

    // 使用半拉格朗日法回溯位移，确保不可压缩性
    float2 add_uv = uv + u_new;
    float2 add_disp = _DispTex.SampleLevel(samplerLinearClamp, add_uv, 0).xy;

    float2 add_hole = _HoleTex.SampleLevel(samplerLinearClamp, add_uv, 0);
    */
    // ── 6. 空洞输入（仅鼠标，无自增长）──
    float distToPen = length(uv - _PenPos.xy);
    //float lineDist  = distToLine(uv, _PenPos.xy, _PenPos.zw);
    //float minDist   = min(distToPen, lineDist);
    float inHole = (1.0 - smoothstep(_Radius*0.8, _Radius, distToPen)) * _KeyDown;
    float erzhiinHole = (1.0 - step(_Radius,distToPen)) * _KeyDown;

    //newTensileForce += (1.0 - smoothstep(_Radius,_Radius + 0.05, distToPen)) * _KeyDown * _DT;

    //// 拉扯力
    //float newTensileForce = add_hole.y;
    //newTensileForce += excessStretch ;
    //
    //// 空洞一旦设下就永久保留
    //add_hole = max(add_hole, inHole);

    
    ////*********************** 以下为新部分 ********************************
    pixelParticle p = getPaticleData(pos);

    // 仅对非固定、未撕裂的粒子执行
    if (!p.disabled && !p.pinned)
    {

        p.prevUV = p.curUV; // 保存当前uv坐标到上一帧

        int2 a, b, l, r;
        a = b = l = r = pos;

        float rlen = h; // 粒子间距

        for (float i = 1.; i < 5; ++i)
        {
            a += int2( 0,  1);   // 链式向上迭代
            b += int2( 0, -1);   // 链式向下迭代
            r += int2( 1,  0);   // 链式向右迭代
            l += int2(-1,  0);   // 链式向左迭代

            float sLen = rlen * i;    // 第 i 层的期望长度 = 基础距离 × i
            constraint(a, p, sLen);       // 约束上方第 i 个邻居
            constraint(b, p, sLen);       // 约束下方第 i 个邻居
            constraint(r, p, sLen);       // 约束右方第 i 个邻居
            constraint(l, p, sLen);       // 约束左方第 i 个邻居
        }
    }

    // ── 写入 ──
    //_DispWrite[pos] = float4(disp_self + lache*_DT, 0, 0);
    _DispWrite[pos] = float4(p.curUV, p.prevUV);
    _HoleWrite[pos] = float2(saturate(hole_self.x+erzhiinHole),0);
}

