#pragma kernel ComputeGravityMap
#pragma kernel ExtendOutline

// ============================================
// 参数
// ============================================
float _TexSize;                    // 纹理大小
float _OutlineWidth;               // 轮廓扩展宽度
float3 _RelativeGravity;           // 相对重力方向（已根据物体旋转逆变换）

// ============================================
// 纹理资源
// ============================================
// 物体空间位置图：xyz=位置，w=有效标记(1=有效,0=无效)
Texture2D<float4> _OSPosMap;
// 输出重力图：xy=流动方向
RWTexture2D<float2> _GravityMap;
// 用于轮廓扩展的读取纹理
Texture2D<float2> _GravityMapRead;
// SDF图：单通道，存储到UV岛边界的距离
Texture2D<float> _SDFMap;
// SDF梯度图：xy=梯度方向（指向UV岛边界）
Texture2D<float2> _SDFGradientMap;
// UV跳跃贴图参数
Texture2D<float4> _UVJumpMap;  // UV跳跃贴图（RG:跳跃目标UV, Z:跳跃边缘, A:UV范围）
// ============================================
// 采样器
// ============================================
SamplerState samplerLinearClamp;

// ============================================
// 核心计算内核
// 通过采样周围8个方向，计算与相对重力方向最匹配的流动方向
// ============================================
[numthreads(8, 8, 1)]
void ComputeGravityMap(uint3 id : SV_DispatchThreadID)
{
    // 边界检查
    if (id.x >= (uint)_TexSize || id.y >= (uint)_TexSize)
        return;

    float2 uv = (float2(id.xy) + 0.5) / _TexSize;
    float4 uvJumpData = _UVJumpMap.SampleLevel(samplerLinearClamp, uv, 0);
    float2 jumpuv = lerp(uv, uvJumpData.xy, step(0.005,uvJumpData.z));

    // 采样中心位置
    float4 centerData = _OSPosMap.SampleLevel(samplerLinearClamp, uv, 0);
    float4 newCenterData = _OSPosMap.SampleLevel(samplerLinearClamp, uvJumpData.xy, 0)*2.2;
    //center
    //if (centerData.w < 0.5) return;  // 无效区域

    float3 centerPos = centerData.xyz * lerp(1,2.2,step(0.005,uvJumpData.z));
    float2 gradient = float2(0, 0);
    float totalWeight = 0.0;

    
    //float3 uvJumpPos = _OSPosMap.SampleLevel(samplerLinearClamp, uvJumpData.xy, 0).xyz;
    //centerPos = lerp(centerPos, uvJumpPos, step(0.005,uvJumpData.z));
    // 8方向采样
    for (int dx = -1; dx <= 1; dx++)
    {
        for (int dy = -1; dy <= 1; dy++)
        {
            if (dx == 0 && dy == 0) continue;

            float2 neighborUV = uv + float2(dx, dy) / _TexSize;
            float4 neighborUVData = _UVJumpMap.SampleLevel(samplerLinearClamp, neighborUV, 0);
            //neighborUV = lerp(neighborUV, neighborUVData.xy, step(0.005,neighborUVData.z));

            float4 neighborData = _OSPosMap.SampleLevel(samplerLinearClamp, neighborUV, 0);
            
            //neighborUV = lerp(neighborUV, uvJumpData.xy, uvJumpData.z);

            if (neighborData.w < 0.5 ) continue;

            float3 dir = neighborData.xyz*lerp(1,2.2,step(0.005,neighborUVData.z)) - centerPos;
            float dist = length(dir);
            if (dist < 1e-6) continue;

            // 计算与相对重力的相似度
            float similarity = dot(dir / dist, _RelativeGravity);

            // 切线空间方向
            float2 texDir = float2(dx, dy) / length(float2(dx, dy));

            gradient += similarity * texDir;
            totalWeight += abs(similarity);
        }
    }

    // 归一化输出
    float len = length(gradient);
    _GravityMap[id.xy] = len > 1e-6 ? ((gradient / len)*0.5+0.5) : float2(0, 0);
    //_GravityMap[id.xy] = uvJumpData.xy;
    //_GravityMap[id.xy] = uv;
}
// ============================================
// 轮廓扩展内核 + 双边滤波
// 1. 在轮廓扩展区域内，将UV岛边缘向外扩展
// 2. 在非轮廓扩展区域内，应用双边滤波平滑
// ============================================
[numthreads(8, 8, 1)]
void ExtendOutline(uint3 id : SV_DispatchThreadID)
{
    // 边界检查
    if (id.x >= (uint)_TexSize || id.y >= (uint)_TexSize)
        return;

    float2 uv = (float2(id.xy) + 0.5) / _TexSize;
    float2 w = float2(1.0/_TexSize,0.0);
    // 分别采样SDF和梯度
    float sdf_adjust = 0.003;
    float sdf = _SDFMap.SampleLevel(samplerLinearClamp, uv, 0);
    float sdf_r = _SDFMap.SampleLevel(samplerLinearClamp, uv+w.xy, 0) + sdf_adjust;
    float sdf_l = _SDFMap.SampleLevel(samplerLinearClamp, uv-w.xy, 0) + sdf_adjust;
    float sdf_u = _SDFMap.SampleLevel(samplerLinearClamp, uv+w.yx, 0) + sdf_adjust;
    float sdf_d = _SDFMap.SampleLevel(samplerLinearClamp, uv-w.yx, 0) + sdf_adjust;
    float2 sdfGradient = -normalize(float2(sdf_r - sdf_l, sdf_u - sdf_d));

    float2 gradient = _SDFGradientMap.SampleLevel(samplerLinearClamp, uv, 0);
    sdfGradient = gradient;

    // 判断是否在轮廓扩展范围内
    // sdf < _OutlineWidth/_TexSize 表示在扩展范围内（UV岛外部）
    float inOutlineArea = step(sdf, _OutlineWidth / _TexSize) * step(-0.005, sdf);
    float2 outLine = float2(0,0);
    if (inOutlineArea > 0.0)
    {
        // 在轮廓扩展区域内，执行轮廓扩展逻辑
        // 计算边缘UV位置：沿梯度方向移动sdf距离
        float2 edgeUV = clamp(uv + (sdf + 0.003) * gradient, float2(0.0, 0.0), float2(1.0, 1.0));
        
        // 采样边缘位置的重力方向
        float2 edgeGravity = _GravityMapRead.SampleLevel(samplerLinearClamp, edgeUV, 0);
        
        // 输出扩展后的值
        outLine = edgeGravity;
        //outLine = sdfGradient.xy;
        //return;
    }
    _GravityMap[id.xy] = float2(1,1)*step(sdf, _OutlineWidth / _TexSize)*step(-0.005, sdf);
    //_GravityMap[id.xy] = float2(1,1)*sdfGradient;
    _GravityMap[id.xy] = lerp(_GravityMapRead[id.xy], outLine,step(sdf, _OutlineWidth / _TexSize)*step(-0.005, sdf) );
    /*
    else
    {
        // 不在轮廓扩展区域内，应用双边滤波
        // 中心像素的重力方向
        float2 centerGravity = _GravityMapRead.SampleLevel(samplerLinearClamp, uv, 0);
        
        // 双边滤波参数
        float sigmaSpace = 3.0;      // 空间标准差
        float sigmaColor = 0.3;      // 颜色标准差
        int kernelRadius = 1;    // 滤波核半径
        
        // 预计算高斯参数
        float twoSigmaSpace2 = 2.0 * sigmaSpace * sigmaSpace;
        float twoSigmaColor2 = 2.0 * sigmaColor * sigmaColor;
        
        float weightSum = 0.0;
        float2 gravitySum = float2(0.0, 0.0);
        
        // 遍历滤波窗口
        for (int i = -kernelRadius; i <= kernelRadius; i++)
        {
            for (int j = -kernelRadius; j <= kernelRadius; j++)
            {
                // 跳过中心点（如果需要）
                if (i == 0 && j == 0) continue;
                
                // 计算偏移后的UV坐标
                float2 offset = float2(i, j) / _TexSize;
                float2 sampleUV = uv + offset;
                
                // 检查是否在轮廓扩展区域内
                float sampleSdf = _SDFMap.SampleLevel(samplerLinearClamp, sampleUV, 0);
                float sampleInOutlineArea = step(sampleSdf, _OutlineWidth / _TexSize) * step(0.0, sampleSdf);
                
                // 如果采样点在轮廓扩展区域内，可以选择跳过或降低权重
                // 这里我们选择跳过，避免从轮廓扩展区域采样
                if (sampleInOutlineArea > 0.0) continue;
                
                sampleUV = clamp(sampleUV, 0.0, 1.0);
                
                // 采样邻居像素的重力方向
                float2 sampleGravity = _GravityMapRead.SampleLevel(samplerLinearClamp, sampleUV, 0);
                
                // 1. 计算空间权重（基于像素距离）
                float spaceDist = i * i + j * j;  // 平方距离
                float spaceWeight = exp(-spaceDist / twoSigmaSpace2);
                
                // 2. 计算颜色权重（基于重力方向差异）
                // 计算两个二维向量的欧氏距离
                float2 gravityDiff = sampleGravity - centerGravity;
                float colorDist = length(gravityDiff);
                float colorWeight = exp(-colorDist * colorDist / twoSigmaColor2);
                
                // 3. 综合权重 = 空间权重 × 颜色权重
                float totalWeight = spaceWeight * colorWeight;
                
                // 累加权重和重力方向
                weightSum += totalWeight;
                gravitySum += sampleGravity * totalWeight;
            }
        }
        
        // 归一化输出
        // 如果权重和太小，则保持原值
        float2 resultGravity = (weightSum > 1e-6) ? (gravitySum / weightSum) : centerGravity;
        _GravityMap[id.xy] = resultGravity;
        //_GravityMap[id.xy] = float2(1,1)*sdf;
    }
        */
    //_GravityMap[id.xy] = _GravityMapRead.SampleLevel(samplerLinearClamp, uv, 0);;
    //_GravityMap[id.xy] = float2(0,0);

}