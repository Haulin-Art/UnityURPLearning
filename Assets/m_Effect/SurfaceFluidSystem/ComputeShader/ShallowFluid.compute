#pragma kernel ShallowWaterKernel

#include "UnityCG.cginc"

// 模拟参数
float texSize;          // 纹理大小
float dt;               // 时间步长
float advectSpeed;      // 平流速度
float2 attenuation;     // 速度衰减与高度衰减

// 射线检测源参数
float2 sourceUV;        // 射线检测到的UV位置
int isHit;              // 是否命中目标
float radius;           // 画笔半径

// UV跳跃贴图参数
Texture2D<float4> UVJumpMap;  // UV跳跃贴图（RG:跳跃目标UV, Z:跳跃边缘, A:UV范围）
int useUVJump;                // 是否启用UV跳跃功能

// 重力方向图参数
Texture2D<float2> GravityMap; // 重力方向贴图（RG通道存储方向，范围0~1）
int useGravityMap;            // 是否启用重力图
float gravityStrength;        // 重力强度

// 床底高度图参数
Texture2D<float> BedHeightMap;  // 床底高度图（噪波地形）
int useBedHeight;               // 是否启用床底高度图
float bedHeightScale;           // 床底高度缩放系数

// 调试模式参数
// 0: None, 1: ShowHeightField, 2: ShowVelocityField, 3: ShowGravityMap, 4: ShowUVJumpMap, 5: ShowBedHeight, 6: ShowSurfaceHeight
int debugMode;

// 纹理采样器（线性插值）
SamplerState samplerLinearClamp
{
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Clamp;
    AddressV = Clamp;
};
SamplerState samplerLinearRepeat
{
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Repeat;
    AddressV = Repeat;
};
// 读写纹理
RWTexture2D<float2> VelocityWrite;
RWTexture2D<float> HeightWrite;

// 只读纹理（用于采样器采样）
Texture2D<float2> VelocityTex;
Texture2D<float> HeightTex;

/// <summary>
/// 获取重力方向（从重力图采样并映射到-1~1）
/// </summary>
float2 GetGravityDirection(float2 uv)
{
    if (useGravityMap == 0)
    {
        return float2(0, 0);
    }

    float2 gravityDir = GravityMap.SampleLevel(samplerLinearClamp, uv, 0).xy;
    gravityDir = gravityDir * 2.0 - 1.0;
    return gravityDir;
}

/// <summary>
/// 获取床底高度（从床底高度图采样）
/// </summary>
float GetBedHeight(float2 uv)
{
    if (useBedHeight == 0)
    {
        return 0.0;
    }
    float bed_tiling = 8.0;
    float bedHeight = BedHeightMap.SampleLevel(samplerLinearRepeat, uv * bed_tiling, 0).x;
    return bedHeight * bedHeightScale;
}

/// <summary>
/// 浅水方程核
/// 连续性方程：∂h/∂t + ∇·(hv) = 0  即  新高度 = 旧高度 - 散度(速度 * 高度) * dt
/// 动量方程：∂v/∂t + (v·∇)v = -g∇η - friction*v  即  新速度 = 平流后的速度 - g * 水面梯度 * dt - 摩擦力项 * dt
/// 其中 η = h + b（水面高度 = 水深 + 床底高度）
/// </summary>
[numthreads(8, 8, 1)]
void ShallowWaterKernel(uint3 id : SV_DispatchThreadID)
{
    uint2 pixel_pos = id.xy;
    float2 uv = ((float2)id.xy + 0.5) / texSize;
    float2 w = float2(1.0 / texSize, 0.0);
    w = float2(1.0 / 256.0, 0.0);

    // 读取上一帧数据
    float2 old_vel = VelocityTex.SampleLevel(samplerLinearClamp, uv, 0).xy;
    float old_height = HeightTex.SampleLevel(samplerLinearClamp, uv, 0).x;

    // 获取重力方向
    float2 gravityDir = GetGravityDirection(uv);

    // ========== 平流项：半拉格朗日法 ==========
    // 回溯UV（结合速度和重力方向）
    float2 backtracedUV = uv - advectSpeed * old_vel * dt;
    backtracedUV = clamp(backtracedUV, 0.0, 1.0);

    float2 adUV = backtracedUV;

    // 采样平流后的速度
    float2 ad_vel = VelocityTex.SampleLevel(samplerLinearClamp, adUV, 0).xy;

    // 采样平流后的高度
    float ad_height = HeightTex.SampleLevel(samplerLinearClamp, adUV, 0).x;

    // ========== 计算床底高度 ==========
    float b_center = GetBedHeight(uv);
    float b_right = GetBedHeight(uv + w.xy);
    float b_left = GetBedHeight(uv - w.xy);
    float b_up = GetBedHeight(uv - w.yx);
    float b_down = GetBedHeight(uv + w.yx);

    // ========== 计算水面高度和梯度（用于动量方程） ==========
    // 水面高度 η = h + b（水深 + 床底高度）
    adUV = uv;
    float h_center = ad_height;
    float h_right = HeightTex.SampleLevel(samplerLinearClamp, adUV + w.xy, 0).x;
    float h_left = HeightTex.SampleLevel(samplerLinearClamp, adUV - w.xy, 0).x;
    float h_up = HeightTex.SampleLevel(samplerLinearClamp, adUV - w.yx, 0).x;
    float h_down = HeightTex.SampleLevel(samplerLinearClamp, adUV + w.yx, 0).x;

    // 水面高度 = 水深 + 床底高度
    float eta_center = h_center + b_center;
    float eta_right = h_right + b_right;
    float eta_left = h_left + b_left;
    float eta_up = h_up + b_up;
    float eta_down = h_down + b_down;

    // 水面梯度（这是驱动水流的关键）
    float detadx = (eta_right - eta_left) * 0.5;
    float detady = (eta_down - eta_up) * 0.5;
    float2 surface_gradient = float2(detadx, detady);

    // ========== 计算通量散度（用于连续性方程） ==========
    // 通量 = 水深 * 速度
    float2 flux_center = h_center * ad_vel;
    float2 flux_right = h_right 
                       * VelocityTex.SampleLevel(samplerLinearClamp, adUV + w.xy, 0).xy;
    float2 flux_left = h_left
                      * VelocityTex.SampleLevel(samplerLinearClamp, adUV - w.xy, 0).xy;
    float2 flux_up = h_up
                    * VelocityTex.SampleLevel(samplerLinearClamp, adUV - w.yx, 0).xy;
    float2 flux_down = h_down
                      * VelocityTex.SampleLevel(samplerLinearClamp, adUV + w.yx, 0).xy;

    // 通量散度 = ∂(hv)/∂x + ∂(hv)/∂y
    float flux_divergence = (flux_right.x - flux_left.x) * 0.5 + (flux_down.y - flux_up.y) * 0.5;

    // 表面张力项
    // 计算高度的拉普拉斯（曲率）
    float laplacian_h = (h_right + h_left + h_up + h_down - 4.0 * h_center);
    // 表面张力系数
    float surfaceTension = 0.01;

    // ========== 动量方程 ==========
    // ∂v/∂t = -g∇η - friction*v + gravity_force
    float friction = 0.002;
    float2 new_vel = ad_vel 
                    - surface_gradient * gravityStrength * dt    // 重力驱动（水面梯度，包含床底影响）
                    - friction * ad_vel * dt                     // 摩擦力
                    + gravityDir * gravityStrength * dt * 0.2    // 外加重力方向力
                    + surfaceTension * laplacian_h * dt;         // 表面张力项

    // ========== 连续性方程 ==========
    // ∂h/∂t = -∇·(hv)
    float new_height = ad_height - flux_divergence * dt;

    // ========== 最小水深阈值（浅水区域停止流动） ==========
    float minDepth = 0.001;
    if (h_center < minDepth)
    {
        // 浅水区域大幅减速，让水流在浅处停止
        new_vel *= 0.1;
    }

    // ========== UV跳跃处理 ==========
    float4 jump_factor = UVJumpMap.SampleLevel(samplerLinearClamp, uv, 0);
    float jump_mask = jump_factor.z * (1.0 - jump_factor.a);
    
    // 获取跳跃目标的高度
    float jump_height = HeightTex.SampleLevel(samplerLinearClamp, jump_factor.xy, 0).x;
    
    // 在边缘处混合高度
    //new_height = lerp(new_height, 0.0, jump_factor.z);
    new_height = lerp(new_height, max(jump_height, new_height), jump_mask);
    
    // 在边缘处将速度方向重映射为重力方向
    float2 jump_vel = VelocityTex.SampleLevel(samplerLinearClamp, jump_factor.xy, 0).xy;
    float2 redirected_vel = length(jump_vel) * gravityDir;
    new_vel = lerp(new_vel, redirected_vel,jump_mask);

    // ========== 衰减 ==========
    // 这里是为了避免在接缝处的高度长期存在，使它快速衰减
    float bed_atten_factor = 5.0 ;
    float bed_attenuation = b_center * bed_atten_factor + 1.0;
    new_height *= jump_mask >= 0.95 ? (1.0 - attenuation.y * 5.0) : (1.0 - attenuation.y * bed_attenuation) ;
    new_vel = lerp(new_vel, 0.0, attenuation.x * bed_attenuation);

    // ========== 限制 ==========
    new_height = clamp(new_height, -5.0, 5.0);
    new_vel = clamp(new_vel, -5.0, 5.0);

    // ========== 添加源（射线检测位置） ==========
    float2 toSource = sourceUV - uv;
    float distToSource = length(toSource);
    float sourceMask = step(distToSource, radius) * isHit;
    new_height += sourceMask * dt;

    // ========== 写入结果 ==========
    // 只在有重力方向的地方更新
    float validMask = step(0.0001, length(gravityDir));
    //validMask = 1;
    HeightWrite[pixel_pos] = new_height * validMask;
    //HeightWrite[pixel_pos] = gravityDir.x;
    VelocityWrite[pixel_pos] = new_vel * validMask;
}
