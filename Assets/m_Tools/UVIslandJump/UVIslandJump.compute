#pragma kernel CSMain
#pragma kernel CSBlur

Texture2D<float4> WorldPosTexture;
Texture2D<float4> SDFTexture;
Texture2D<float4> DirectionTexture;
Texture2D<float4> DiscriminantTexture;
Texture2D<float4> InputTexture;
RWTexture2D<float4> OutputTexture;

int _Width;
int _Height;
int _BorderSize;
float _MinDistance;
float _DiscriminantThreshold;
int _BlurRadius;

float3 GetWorldPos(int2 uv)
{
    if (uv.x < 0 || uv.x >= _Width || uv.y < 0 || uv.y >= _Height)
        return float3(0, 0, 0);

    float4 color = WorldPosTexture[uv];
    return color.rgb;
}

float3 GetDiscriminant(int2 uv)
{
    if (uv.x < 0 || uv.x >= _Width || uv.y < 0 || uv.y >= _Height)
        return float3(0, 0, 0);

    float4 color = DiscriminantTexture[uv];
    return color.rgb;
}

bool IsValidSample(float4 color)
{
    return length(color.rg) > 0.001;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height)
        return;

    int2 samplePos = int2(id.x, id.y);

    float sdf = SDFTexture[samplePos].r;

    float maxResolution = (float)max(_Width, _Height);
    float borderThreshold = (float)_BorderSize / maxResolution;

    float borderMask = step(0.0001, sdf) * step(sdf, borderThreshold);

    if (borderMask < 0.5)
    {
        OutputTexture[samplePos] = float4(0, 0, 0, 1.0);
        return;
    }

    float2 direction = DirectionTexture[samplePos].rg * 2.0 - 1.0;

    float pixelDistance = _BorderSize + 0.5;

    float2 offsetPos = samplePos + direction * pixelDistance;
    int2 borderPos = int2(ceil(offsetPos.x), ceil(offsetPos.y));

    float3 referencePos = GetWorldPos(borderPos);
    float3 referenceDiscriminant = GetDiscriminant(borderPos);

    if (length(referencePos) < 0.001)
    {
        OutputTexture[samplePos] = float4(0, 0, 0, 1.0);
        return;
    }

    float minDist = 1e10;
    int2 bestPos = int2(-1, -1);

    for (int y = 0; y < _Height; y++)
    {
        for (int x = 0; x < _Width; x++)
        {
            int2 currentPos = int2(x, y);
            float3 worldPos = GetWorldPos(currentPos);

            if (length(worldPos) < 0.001)
                continue;

            float dist = distance(worldPos, referencePos);

            if (dist < minDist)
            {
                float pixelDist = distance(float2(samplePos), float2(currentPos));

                if (pixelDist > _MinDistance)
                {
                    float3 currentDiscriminant = GetDiscriminant(currentPos);
                    float discriminantDiff = distance(currentDiscriminant, referenceDiscriminant);

                    if (discriminantDiff > _DiscriminantThreshold)
                    {
                        minDist = dist;
                        bestPos = currentPos;
                    }
                }
            }
        }
    }

    if (bestPos.x >= 0 && bestPos.y >= 0)
    {
        float2 uvCoord = float2(bestPos.x / (float)_Width, bestPos.y / (float)_Height);
        OutputTexture[samplePos] = float4(uvCoord, 0, 1.0);
    }
    else
    {
        OutputTexture[samplePos] = float4(0, 0, 0, 1.0);
    }
}
[numthreads(8, 8, 1)]
void CSBlur(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Width || id.y >= _Height)
        return;

    int2 samplePos = int2(id.x, id.y);

    float sdf = SDFTexture[samplePos].r;

    float maxResolution = (float)max(_Width, _Height);
    float borderThreshold = (float)_BorderSize / maxResolution;

    float borderMask = step(0.0001, sdf) * step(sdf, borderThreshold);

    if (borderMask < 0.5)
    {
        OutputTexture[samplePos] = float4(id.xy/maxResolution, 0, 1.0);
        return;
    }

    float2 sum = float2(0, 0);
    float weightSum = 0.0;

    for (int y = -_BlurRadius; y <= _BlurRadius; y++)
    {
        for (int x = -_BlurRadius; x <= _BlurRadius; x++)
        {
            int2 neighborPos = samplePos + int2(x, y);

            if (neighborPos.x < 0 || neighborPos.x >= _Width || 
                neighborPos.y < 0 || neighborPos.y >= _Height)
                continue;

            float4 neighborColor = InputTexture[neighborPos];

            if (!IsValidSample(neighborColor))
                continue;

            float dist = length(float2(x, y));
            float weight = exp(-dist * dist / (2.0 * (_BlurRadius / 2.0) * (_BlurRadius / 2.0)));

            sum += neighborColor.rg * weight;
            weightSum += weight;
        }
    }

    if (weightSum > 0.001)
    {
        float2 blurredUV = sum / weightSum;
        OutputTexture[samplePos] = float4(blurredUV, 0, 1.0);
    }
    else
    {
        OutputTexture[samplePos] = float4(0, 0, 0, 1.0);
    }
}
